	Skl(0)
	Spd(6)
	Luck(15)
	Def(10)
	Res(6)
	Con(0)
	
	SwordRank(0); LanceRank(0); AxeRank(0); BowRank(0)
	StaffRank(DRank); AnimaRank(0); LightRank(0); DarkRank(0)
	
	HPGrowth(100); PowGrowth(70); SklGrowth(5); SpdGrowth(0)
	LuckGrowth(65); DefGrowth(50); ResGrowth(45)
	
	Attributes(0)
	
	Supports(0)
	
#undef Char

POP
}